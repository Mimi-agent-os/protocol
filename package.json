{
    "name": "@mimi-os/protocol",
    "version": "0.1.0",
    "description": "mimi-os wire vocabulary: neutral LLM types, protocol messages and their parser, the event-log chain hash, and the secure channel core (Noise + ML-KEM-768)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Mimi-agent-os/protocol.git"
    },
    "homepage": "https://github.com/Mimi-agent-os/protocol",
    "bugs": "https://github.com/Mimi-agent-os/protocol/issues",
    "type": "module",
    "license": "Apache-2.0",
    "engines": {
        "node": ">=24"
    },
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "pnpm run clean && tsc -p tsconfig.build.json",
        "check": "tsc",
        "test": "node --test \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
        "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\""
    },
    "dependencies": {
        "@noble/ciphers": "2.4.0",
        "@noble/curves": "2.4.0",
        "@noble/hashes": "2.4.0",
        "@noble/post-quantum": "0.7.1"
    },
    "devDependencies": {
        "@types/node": "^25.6.2",
        "typescript": "6.0.3"
    },
    "packageManager": "pnpm@10.34.5",
    "publishConfig": {
        "access": "public"
    }
}
